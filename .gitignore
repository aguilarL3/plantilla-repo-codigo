# ─── Secretos y credenciales (NUNCA a git) — pegar en el .gitignore del proyecto ───
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*.ppk
*.p12
*.pfx
id_rsa
id_ed25519
credentials.json
.aws/credentials
secrets.json
secrets.yaml
secrets.yml
# Config local de Claude Code (permisos personales; no se comparte)
.claude/settings.local.json
# Python bytecode
__pycache__/
*.pyc
# ─── Artefactos comunes (ajustar al stack en el kickoff) ───
node_modules/
dist/
build/
.venv/
venv/
# Grafo de conocimiento del repo (graphify, local)
graphify-out/
# Marcas de sesión de los hooks (local, nunca a git)
.repo-meta/
