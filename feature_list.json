    {
      "id": 0,
      "name": "000-ejemplo",
      "title": "Feature de Ejemplo (Seed)",
      "description": "Estructura de referencia para el flujo Spec-Driven Development. Reemplazar o borrar al iniciar la primera feature real.",
      "sdd": true,
      "status": "pending"
    }
  ]
}
