#!/usr/bin/env bash
# Git hook pre-commit del baseline de seguridad.
# Se activa con `bash setup.sh` (que hace `git config core.hooksPath .githooks`).
#
# Orden: gate de rama (barato) → secretos → lint/tests (lo más caro, al final).
# Fallar por un secreto no debe costar una corrida entera de la suite.
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || echo "$PWD")"
cd "$ROOT" 2>/dev/null || exit 0

# ── Gate de rama (solo modo equipo) ──────────────────────────────────────────
# En equipo nadie commitea directo a la rama principal: todo entra por PR, que es
# donde otra persona lo revisa y donde corre el workflow `verify`. En modo `solo`
# este bloque no hace nada.
#
# ⚠️ No prometas más de lo que hay: CODEOWNERS puede no existir, y sin reglas de
# rama (plan Free + repo privado) el `verify` del PR es señal y no bloqueo. Este
# gate local suele ser el ÚNICO control automático real — de ahí que el mensaje
# de abajo no mencione controles de servidor que quizás no estén.
#
# repo.conf se PARSEA, no se sourcea: es un archivo versionado que ejecutaría
# shell en la máquina de cada colaborador en cada commit. Un `. ./repo.conf`
# convierte un PR a un archivo de config en ejecución remota de código.
conf_get() {
  val="$(sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*\([A-Za-z0-9._/-]*\).*/\1/p" repo.conf 2>/dev/null | head -1)"
  if [ -n "$val" ]; then printf '%s' "$val"; else printf '%s' "$2"; fi
}
REPO_MODE="$(conf_get REPO_MODE solo)"
MAIN_BRANCH="$(conf_get MAIN_BRANCH main)"

if [ "$REPO_MODE" = "equipo" ] && [ ! -f .repo-meta/branch-gate.disabled ]; then
  BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")"
  if [ "$BRANCH" = "$MAIN_BRANCH" ]; then
    echo "🔴 pre-commit: este repo está en REPO_MODE=equipo y estás sobre «$MAIN_BRANCH»." >&2
    echo "" >&2
    echo "   En equipo, $MAIN_BRANCH entra solo por PR: ahí lo revisa la otra persona." >&2
    echo "   Movete a tu rama y volvé a commitear:" >&2
    echo "" >&2
    echo "     git switch -c <tu-prefijo>/<tema>      # ej. le/login-oauth" >&2
    echo "" >&2
    echo "   El prefijo es de DOS letras, no la inicial (con dos personas que" >&2
    echo "   comparten inicial, la inicial sola es ambigua)." >&2
    if [ -f COMO-TRABAJAMOS.md ]; then
      echo "   Cuál te toca: ./COMO-TRABAJAMOS.md §2" >&2
    fi
    echo "" >&2
    echo "   Si ya commiteaste sobre $MAIN_BRANCH y querés rescatar el trabajo:" >&2
    echo "     git switch -c <tu-prefijo>/<tema> && git switch $MAIN_BRANCH && git reset --hard origin/$MAIN_BRANCH" >&2
    echo "" >&2
    echo "   (Excepción puntual: git commit --no-verify. Kill-switch: .repo-meta/branch-gate.disabled)" >&2
    exit 1
  fi
fi

# ── Secretos (bloqueante, siempre) ───────────────────────────────────────────
bash "$ROOT/.claude/hooks/secret-scan.sh" || exit 1

# ── Lint y tests del stack ───────────────────────────────────────────────────
# Cablear en el kickoff (paso 6), mismos comandos que .github/workflows/verify.yml.
# Van al final a propósito: son lo más lento del hook.
# npm run lint || exit 1
# npm test     || exit 1

exit 0
