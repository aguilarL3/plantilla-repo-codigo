#!/usr/bin/env bash
# Git hook pre-commit del baseline de seguridad.
# Se activa con `bash setup.sh` (que hace `git config core.hooksPath .githooks`).
#
# Orden: gate de rama (barato, modo equipo) → secretos (bloqueante siempre).
# En el kickoff se agregan acá lint y tests del stack, ANTES del exec final.
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || echo "$PWD")"
cd "$ROOT" 2>/dev/null || exit 0

# ── Gate de rama (solo modo equipo) ──────────────────────────────────────────
# En equipo nadie commitea directo a la rama principal: todo entra por PR, que
# es donde corren CODEOWNERS y el workflow `verify`. Committear a main saltea
# las dos cosas. En modo `solo` este bloque no hace nada.
REPO_MODE="solo"; MAIN_BRANCH="main"
# shellcheck disable=SC1091
[ -f repo.conf ] && . ./repo.conf 2>/dev/null

if [ "$REPO_MODE" = "equipo" ] && [ ! -f .repo-meta/branch-gate.disabled ]; then
  BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")"
  if [ "$BRANCH" = "$MAIN_BRANCH" ]; then
    echo "🔴 pre-commit: este repo está en REPO_MODE=equipo y estás sobre «$MAIN_BRANCH»." >&2
    echo "" >&2
    echo "   En equipo, main entra solo por PR (ahí corren CODEOWNERS y el workflow verify)." >&2
    echo "   Movete a una rama y volvé a commitear:" >&2
    echo "" >&2
    echo "     git switch -c <inicial>/<tema>      # ej. b/login-oauth" >&2
    echo "" >&2
    echo "   Si ya commiteaste sobre $MAIN_BRANCH y querés rescatar el trabajo:" >&2
    echo "     git switch -c <inicial>/<tema> && git switch $MAIN_BRANCH && git reset --hard origin/$MAIN_BRANCH" >&2
    echo "" >&2
    echo "   (Excepción puntual: git commit --no-verify. Kill-switch: .repo-meta/branch-gate.disabled)" >&2
    exit 1
  fi
fi

# ── Lint y tests del stack ───────────────────────────────────────────────────
# Cablear en el kickoff (paso 6), mismos comandos que .github/workflows/verify.yml:
# npm run lint || exit 1
# npm test     || exit 1

# ── Secretos (bloqueante, siempre) ───────────────────────────────────────────
exec bash "$ROOT/.claude/hooks/secret-scan.sh"
